{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catwoman-cloudflare",
  "main": "src/index.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "minify": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
